    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript7/bin/tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-barcode-scanner": "^2.1.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "typescript7": "npm:typescript@~7.0.2"
  },
  "engines": {
    "node": ">=24.22.2 <25 || >=26.13.0"
