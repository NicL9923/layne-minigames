{
  "name": "layne-minigames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript7/bin/tsc -b && vite build",
    "lint": "eslint .",
